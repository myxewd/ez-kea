# deploy/kea.env.example - environment for the compose deployment.
#
#   cp kea.env.example kea.env
#   # then edit every value marked CHANGE ME
#   chmod 600 kea.env        # it holds the session key and, later, a license
#
# The same file is read by docker compose (through env_file:) and by
# `docker compose --env-file kea.env`, so the variables below both configure
# the container and fill in the compose file's own ${...} substitutions.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# CHANGE ME. Signs the session cookie: anyone who knows it can mint a login
# for your EZ-KEA. Generate one with:  openssl rand -hex 32
# (SECRET_KEY=<64 hex characters>)
# EZ-KEA refuses to start on a non-loopback HOST while this is still 'dev'.
SECRET_KEY=dev

# Where the UI listens. Keep it on loopback and let a reverse proxy do TLS:
# EZ-KEA serves plain HTTP and does not terminate TLS itself.
EZ_KEA_BIND=127.0.0.1
EZ_KEA_PORT=8080

# ---------------------------------------------------------------------------
# Files. All of these are host paths; the compose file mounts them at the
# same absolute path inside both containers, which is what lets EZ-KEA read
# the config with no path translation.
# ---------------------------------------------------------------------------

# Root of the Kea side: conf/, lib/, log/ and run/ live under it.
KEA_ROOT=/opt/ez-kea/kea

# Root of EZ-KEA's own data: the database, app settings, backups and the two
# disposable search indexes. Own it with UID/GID 10001 (see docs/deployment.md).
EZ_KEA_ROOT=/opt/ez-kea

# ---------------------------------------------------------------------------
# How EZ-KEA reloads the daemon after a save
# ---------------------------------------------------------------------------

# control-socket  send `config-reload` to the daemon over its UNIX socket.
#                 No external binary, and it reports whether the reload
#                 actually succeeded. Needs KEA_ROOT/run owned by EZ-KEA's
#                 account (docs/deployment.md explains why that is the
#                 whole trick).
# keactrl         run `keactrl reload`. Kea 3.x from ISC's packages ships no
#                 keactrl at all, so this is only for 2.x installs.
# http            push the configuration over the daemon's own HTTP control
#                 socket: config-test first, config-set only if Kea accepted
#                 it. No reload, no signal, no socket file -- but it needs an
#                 http/https entry under "control-sockets" in the Kea config,
#                 and Kea 2.7.2 or later (docs/deployment.md section 7.4).
# sighup          `docker kill -s HUP <container>`; for minimal images.
KEA_RELOAD_STRATEGY=control-socket

# Only used when KEA_RELOAD_STRATEGY=sighup.
# KEA_DOCKER_CONTAINER=kea

# Only used when KEA_RELOAD_STRATEGY=http. Leave it unset to take the endpoint
# out of the Kea config's "control-sockets" entry; set it when EZ-KEA must
# connect somewhere the daemon's own config does not describe (another host, a
# port published out of the Kea container).
# KEA_HTTP_URL=http://kea:8000/
# KEA_HTTP_URL6=http://kea6:8001/     # the v6 daemon needs its own port

# Basic credentials for that channel. Kea 3.x refuses to start with an
# unauthenticated HTTP control channel, so a 3.x daemon needs an
# "authentication": {"type": "basic", ...} block using user-file/password-file
# (a clear-text password in Kea's own config is refused too) and EZ-KEA needs
# the same credential here -- environment only, never written to a file.
# KEA_HTTP_USER=admin
# KEA_HTTP_PASSWORD=change-me

# ---------------------------------------------------------------------------
# The daemon image (see ../kea/Dockerfile)
# ---------------------------------------------------------------------------
KEA_IMAGE=ez-kea-kea:2.2.0

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# A commercial license key, if you have one. Store it here rather than in the
# UI so a rebuilt container keeps it; see docs/deployment.md.
# EZ_KEA_LICENSE_KEY=EZK1....

# How far back the searchable Kea log history is kept, in days
# (0 keeps everything). The index is disposable and rebuilds itself.
# LOG_INDEX_RETENTION_DAYS=365

# Whether the two background indexers run at all.
# LOG_INDEX_ENABLED=1
# STATE_INDEX_ENABLED=1
