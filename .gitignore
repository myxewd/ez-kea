# Databases
*.sqlite3
*.db
# SQLite WAL sidecars — the log index runs in WAL mode, so these sit next to
# the .db file and aren't caught by the pattern above.
*.db-wal
*.db-shm

# OS / Editors
.DS_Store
.idea/
.vscode/
*.swp
*~

# Project Specific
backups/
*.bak.*
data/
.gemini/
.agents/
.playwright-mcp/

# Vendor-side license signing key — NEVER distributed with the app itself
# (see ez_kea/license.py / license_gen.py). Only the public key is embedded
# in ez_kea/license.py; the private key must stay offline.
keys/
# Only ignore the dynamically-generated Kea data under testbed/data/ (mirrors
# testbed/.gitignore) -- NOT the whole directory, so the committed
# kea-dhcp4.conf.example and pre-seeded ez-kea-settings.json stay tracked.
testbed/data/var/
testbed/data/etc/kea/kea-dhcp4.conf

# Local agent context — machine-specific notes, not part of the product
CLAUDE.md

# Local verification harness (scratch: boot a throwaway EZ-KEA + real Kea in WSL)
local-verify/
